# 闪裳Live 服务端环境变量示例。复制为 .env 后填写；真实 .env 不入库。

# 监听地址与端口（nginx 反代到这里，只监听本机）
HOST=127.0.0.1
PORT=8300

# SQLite 与上传文件目录
DATA_DIR=./data

# 部署在 nginx 后面时设为 1，才能拿到真实客户端 IP（登录限流用）
TRUST_PROXY=0
# 走 HTTPS 时设为 1，会话 Cookie 只在 HTTPS 下发送
COOKIE_SECURE=0
# 会话有效期（小时）
SESSION_TTL_HOURS=168

# 首次启动时创建唯一超级管理员；已存在管理员时不会覆盖。口令至少 12 位
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Xmax 国内站：永久密钥只放这里，设备只能拿临时密钥
XMAX_API_KEY=
XMAX_API_BASE=
XMAX_KEY_EXPIRE_SECONDS=3600
XMAX_KEY_POINTS_LIMIT=200

# 快照二维码使用的外网地址（含部署前缀，末尾不带 /），快照链接 = 该地址 + /s/<token>；
# 留空时按请求的协议和 Host 推算，仅适合本地开发
PUBLIC_BASE_URL=

# 演示商家（npm run seed），密码留空则随机生成并只打印一次
SEED_DEMO_USERNAME=demo
SEED_DEMO_PASSWORD=
