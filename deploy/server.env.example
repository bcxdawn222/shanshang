# 闪裳Live 服务端 · 服务器环境变量模板
#
# 放到服务器 /etc/shanshang/server.env，权限 600、属主 root：
#   install -d -m 750 /etc/shanshang
#   install -m 600 -o root -g root server.env.example /etc/shanshang/server.env
# systemd 以 root 读取后注入进程，服务用户 shanshang 不需要也不应该能读这个文件。
# 格式：KEY=VALUE，一行一个，不要加引号和行尾注释。真实文件不入库。
# 布尔开关在代码里只认 1（不是 true）。

# 运行模式
NODE_ENV=production

# 只监听本机，由 nginx 反代；端口与 nginx 的 proxy_pass 保持一致
HOST=127.0.0.1
PORT=8300

# 数据目录：SQLite 数据库 + media/（服饰图、广告视频、快照图）。必须是绝对路径，
# 与 systemd unit 的 ReadWritePaths 一致
DATA_DIR=/var/lib/shanshang
# 数据库文件，默认 DATA_DIR/shanshang.db，一般不用改
#DB_FILE=/var/lib/shanshang/shanshang.db

# 在 nginx 后面必须为 1：否则所有请求的 IP 都是 127.0.0.1，登录限流会把所有人一起锁住
TRUST_PROXY=1
# 已上 HTTPS 时为 1：会话 Cookie 只在 HTTPS 下发送。仍是 HTTP 时设 1 会导致无法登录
COOKIE_SECURE=1
# 后台登录会话有效期（小时）
SESSION_TTL_HOURS=168

# 快照二维码使用的外网地址（Phase 5），不带结尾斜杠。开发期带 /sl 前缀，生产按实际前缀
PUBLIC_BASE_URL=https://<DOMAIN>/sl

# 首次启动时创建唯一超级管理员；库里已有管理员时忽略。口令至少 12 位。
# 首次启动成功、登录确认后，删掉这两行的值并重启，不要长期留在文件里
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Xmax 国内站：永久密钥只放这里（上线前在 Xmax 平台重建，旧密钥作废）
XMAX_API_KEY=
XMAX_API_BASE=
# 签发给设备的临时密钥：有效期（秒）与积分上限
XMAX_KEY_EXPIRE_SECONDS=3600
XMAX_KEY_POINTS_LIMIT=200
